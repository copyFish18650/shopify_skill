{% assign catalog_form_id = 'CatalogFilters-' | append:section.id %}{% assign catalog_panel_id = 'CatalogPanel-' | append:section.id %}
{% assign active_sort = results.sort_by | default:results.default_sort_by %}{% assign catalog_filter_count = 0 %}
{% for filter in results.filters %}{% assign catalog_filter_count = catalog_filter_count | plus:filter.active_values.size %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}{% assign catalog_filter_count = catalog_filter_count | plus:1 %}{% endif %}{% endif %}{% endfor %}
{% assign catalog_context_path = request.path | default:results.url | split:'?' | first %}{% if catalog_context_path == blank %}{% if request.page_type == 'search' %}{% assign catalog_context_path = routes.search_url %}{% else %}{% assign catalog_context_path = routes.all_products_collection_url %}{% endif %}{% endif %}
{% assign catalog_context_query = '' %}{% if request.page_type == 'search' %}{% assign catalog_context_query = search.terms %}{% elsif collection.current_type != blank %}{% assign catalog_context_query = collection.current_type %}{% elsif collection.current_vendor != blank %}{% assign catalog_context_query = collection.current_vendor %}{% endif %}
{% capture catalog_clear_url %}{{ catalog_context_path }}?{% if catalog_context_query != blank %}q={{ catalog_context_query | url_encode }}&{% endif %}{% if request.page_type == 'search' %}options[prefix]=last&{% if search.types.size > 0 %}type={{ search.types | join:',' | url_encode }}&{% endif %}{% endif %}{% if active_sort != blank %}sort_by={{ active_sort | url_encode }}{% endif %}{% endcapture %}
<div class="catalog-controls{% if settings.catalog_controls_sticky %} is-sticky{% endif %}" data-catalog-controls data-catalog-style="{{ settings.catalog_control_style | default:'line' }}">
<form id="{{ catalog_form_id }}" class="catalog-filter-form" method="get" action="{{ catalog_context_path }}" data-catalog-form>
{% if catalog_context_query != blank %}<input type="hidden" name="q" value="{{ catalog_context_query | escape }}">{% endif %}
{% if request.page_type == 'search' %}<input type="hidden" name="options[prefix]" value="last">{% if search.types.size > 0 %}<input type="hidden" name="type" value="{{ search.types | join:',' | escape }}">{% endif %}{% endif %}
<div class="catalog-controls__bar">
{% if settings.show_result_count %}<p class="catalog-result-count" role="status"><span data-result-number>{{ result_count }}</span> <span>{% if request.page_type == 'search' %}{% if result_count == 1 %}{{ 'catalog_controls.result' | t }}{% else %}{{ 'catalog_controls.results' | t }}{% endif %}{% else %}{% if result_count == 1 %}{{ 'catalog_controls.product' | t }}{% else %}{{ 'catalog_controls.products' | t }}{% endif %}{% endif %}</span></p>{% endif %}
{% if results.filters.size > 0 or results.sort_options.size > 0 %}<button class="catalog-mobile-trigger" type="button" data-catalog-open aria-controls="{{ catalog_panel_id }}">{% render 'icon',name:'filter' %}<span>{{ 'catalog_controls.filter_sort' | t }}</span>{% if catalog_filter_count > 0 %}<span class="catalog-selection-count">{{ catalog_filter_count }}</span>{% endif %}</button>
<div class="catalog-panel" id="{{ catalog_panel_id }}" data-catalog-panel>
<div class="catalog-panel__header"><h2>{{ 'catalog_controls.filter_sort' | t }}</h2><button type="button" class="icon-button" data-catalog-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon',name:'close' %}</button></div>
<div class="catalog-fields">
{% if results.filters.size > 0 %}<div class="catalog-facets">{% for filter in results.filters %}{% assign filter_position = forloop.index %}<details class="catalog-facet" data-catalog-facet><summary><span>{{ filter.label | escape }}</span>{% if filter.active_values.size > 0 %}<span class="catalog-facet-count" data-facet-count>{{ filter.active_values.size }}</span>{% else %}<span class="catalog-facet-count" data-facet-count hidden></span>{% endif %}<span class="catalog-chevron" aria-hidden="true"></span></summary>
<div class="catalog-facet__panel">{% case filter.type %}{% when 'boolean','list' %}<div class="catalog-filter-values">{% if filter.values.size > 0 %}{% assign filter_batch_last = filter.values.size | divided_by:50.0 | ceil | minus:1 %}{% for filter_batch_index in (0..filter_batch_last) %}{% assign value_offset = filter_batch_index | times:50 %}{% assign value_batch = filter.values | slice:value_offset,50 %}{% render 'catalog-filter-values',values:value_batch,value_offset:value_offset,filter_position:filter_position %}{% endfor %}{% endif %}</div>
{% when 'price_range' %}<div class="catalog-price-range" data-price-range><p class="catalog-price-hint">{{ 'catalog_controls.price_currency' | t }} {{ localization.country.currency.iso_code | default:shop.currency | escape }}</p><div class="catalog-price-fields"><label for="PriceMin-{{ section.id }}-{{ filter_position }}">{{ 'catalog_controls.min' | t }}<input id="PriceMin-{{ section.id }}-{{ filter_position }}" type="number" min="0" step="0.01" inputmode="decimal" name="{{ filter.min_value.param_name | escape }}" placeholder="0"{% if filter.min_value.value != nil %} value="{{ filter.min_value.value | divided_by:100.0 }}"{% endif %} data-price-min></label><span aria-hidden="true">—</span><label for="PriceMax-{{ section.id }}-{{ filter_position }}">{{ 'catalog_controls.max' | t }}<input id="PriceMax-{{ section.id }}-{{ filter_position }}" type="number" min="0" step="0.01" inputmode="decimal" name="{{ filter.max_value.param_name | escape }}" placeholder="{{ filter.range_max | divided_by:100.0 }}"{% if filter.max_value.value != nil %} value="{{ filter.max_value.value | divided_by:100.0 }}"{% endif %} data-price-max></label></div><p class="catalog-input-error" data-price-error hidden>{{ 'catalog_controls.invalid_price' | t }}</p></div>{% endcase %}
<div class="catalog-facet__actions"><button type="submit" class="catalog-apply">{{ 'catalog_controls.apply' | t }}</button>{% if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}">{{ 'catalog_controls.reset_group' | t }}</a>{% endif %}</div></div></details>{% endfor %}</div>{% endif %}
{% if results.sort_options.size > 0 %}<div class="catalog-sort"><label for="SortBy-{{ section.id }}">{{ 'catalog_controls.sort' | t }}</label><div class="catalog-sort__field"><select id="SortBy-{{ section.id }}" name="sort_by" data-catalog-sort>{% for option in results.sort_options %}<option value="{{ option.value }}"{% if option.value == active_sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><span class="catalog-chevron" aria-hidden="true"></span></div></div>{% elsif active_sort != blank %}<input type="hidden" name="sort_by" value="{{ active_sort | escape }}">{% endif %}
</div><div class="catalog-panel__footer"><p class="catalog-draft-note" data-catalog-draft hidden>{{ 'catalog_controls.draft' | t }}</p><button type="submit" class="catalog-apply" data-catalog-apply data-updating-label="{{ 'catalog_controls.updating' | t }}">{{ 'catalog_controls.view_results' | t }}</button>{% if catalog_filter_count > 0 %}<a class="catalog-reset" href="{{ catalog_clear_url }}">{{ 'catalog_controls.clear' | t }}</a>{% endif %}</div>
</div>{% endif %}
</div>
{% if catalog_filter_count > 0 %}<div class="catalog-active-filters" aria-label="{{ 'catalog_controls.active' | t }}">{% for filter in results.filters %}{% for value in filter.active_values %}<a class="catalog-active-chip" href="{{ value.url_to_remove }}"><span>{{ filter.label | escape }}: {{ value.label | escape }}</span>{% render 'icon',name:'close' %}</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<a class="catalog-active-chip" href="{{ filter.url_to_remove }}"><span>{{ filter.label | escape }}: {{ filter.min_value.value | default:0 | money }} – {{ filter.max_value.value | default:filter.range_max | money }}</span>{% render 'icon',name:'close' %}</a>{% endif %}{% endif %}{% endfor %}<a class="catalog-reset" href="{{ catalog_clear_url }}">{{ 'catalog_controls.clear' | t }}</a></div>{% endif %}
</form></div>
