<nav class="catalog-context-nav" aria-label="{{ 'navigation.categories' | t }}"><a href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' and current_tags == blank %} aria-current="page"{% endif %}>{{ 'general.view_all' | t }}</a>
{% assign context_category_count = 0 %}{% for context_collection in collections %}{% if context_collection.handle != 'all' and context_collection.handle != 'frontpage' and context_collection.products_count > 0 and context_category_count < 8 %}{% assign context_category_count = context_category_count | plus:1 %}<a href="{{ context_collection.url }}"{% if context_collection.handle == collection.handle %} aria-current="page"{% endif %}>{{ context_collection.title | escape }}</a>{% endif %}{% endfor %}
{% if context_category_count == 0 %}{% for context_type in collections.all.all_types %}{% if context_type != blank and context_category_count < 8 %}{% assign context_category_count = context_category_count | plus:1 %}{% assign encoded_context_type = context_type | url_encode %}<a href="{{ routes.collections_url }}/types?q={{ encoded_context_type }}"{% if context_type == collection.current_type %} aria-current="page"{% endif %}>{{ context_type | escape }}</a>{% endif %}{% endfor %}{% endif %}</nav>
