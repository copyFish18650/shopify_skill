{% for value in values %}{% assign value_position = value_offset | plus:forloop.index %}{% assign value_id = 'Facet-' | append:section.id | append:'-' | append:filter_position | append:'-' | append:value_position %}
<label class="catalog-filter-value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}" for="{{ value_id }}"><input id="{{ value_id }}" type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span class="catalog-check" aria-hidden="true"></span><span class="catalog-filter-value__label">{{ value.label | escape }}</span><span class="catalog-filter-value__count">{{ value.count }}</span></label>
{% endfor %}
