{% if settings.enable_image_zoom %}<dialog class="retail-image-dialog scheme-light" data-retail-image-dialog aria-label="{{ 'retail.image_viewer' | t }}"><header><p data-retail-image-label></p><button type="button" class="icon-button" data-retail-image-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon',name:'close' %}</button></header><div class="retail-image-dialog__media" data-retail-image-content></div><p class="retail-image-error" data-retail-image-error hidden>{{ 'retail.image_error' | t }}</p></dialog>{% endif %}
