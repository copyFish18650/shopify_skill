{% assign edit_collection = section.settings.collection | default:collections.all %}
{% assign edit_photo_sizes = '(min-width:990px) 45vw, 100vw' %}{% if section.settings.composition == 'poster' %}{% assign edit_photo_sizes = '100vw' %}{% elsif section.settings.composition == 'columns' %}{% assign edit_photo_sizes = '(min-width:990px) 33vw, 100vw' %}{% endif %}
{% if edit_collection.products_count > section.settings.product_offset or request.design_mode %}
<section class="editorial-assortment edit-{{ section.settings.composition }} section-space scheme-{{ section.settings.color_scheme }}" data-editorial-assortment><div class="container edit-layout">
<div class="edit-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div><a class="arrow-link" href="{{ edit_collection.url | default:routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}{% render 'icon',name:'arrow' %}</a></div>
{% if section.settings.image != blank or section.settings.use_bundled_image %}<figure class="edit-photo">{% if section.settings.image != blank %}{{ section.settings.image | image_url:width:1400 | image_tag:widths:'480, 800, 1200, 1400',sizes:edit_photo_sizes,loading:'lazy',alt:section.settings.image_alt }}{% elsif section.settings.use_bundled_image %}<img src="{{ 'editorial-1200.webp' | asset_url }}" srcset="{{ 'editorial-480.webp' | asset_url }} 480w, {{ 'editorial-800.webp' | asset_url }} 800w, {{ 'editorial-1200.webp' | asset_url }} 1200w" sizes="{{ edit_photo_sizes }}" width="1200" height="900" alt="{{ section.settings.image_alt | escape }}" loading="lazy">{% endif %}{% if section.settings.caption != blank %}<figcaption>{{ section.settings.caption | escape }}</figcaption>{% endif %}</figure>{% endif %}
<div class="edit-products">{% for edit_product in edit_collection.products limit:4 offset:section.settings.product_offset %}{% render 'product-card',card_product:edit_product %}{% else %}{% if request.design_mode %}<p class="editor-note">{{ 'storefront.edit_empty' | t }}</p>{% endif %}{% endfor %}</div>
</div></section>{% endif %}
{% schema %}
{"name":"Editorial assortment","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"In the everyday"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"A closer look at useful things."},{"type":"richtext","id":"text","label":"Text","default":"<p>Explore the details, dimensions, and available options for your space.</p>"},{"type":"text","id":"button_label","label":"Link label","default":"Explore the selection"},{"type":"collection","id":"collection","label":"Collection (default: all)"},{"type":"range","id":"product_offset","label":"Skip first products","min":0,"max":24,"step":1,"default":8},{"type":"image_picker","id":"image","label":"Scene photo"},{"type":"checkbox","id":"use_bundled_image","label":"Use included editorial photo","default":false},{"type":"text","id":"image_alt","label":"Photo description"},{"type":"text","id":"caption","label":"Photo caption"},{"type":"select","id":"composition","label":"Composition","default":"board","options":[{"value":"board","label":"Editorial board"},{"value":"rail","label":"Image and product rail"},{"value":"columns","label":"Magazine columns"},{"value":"poster","label":"Large image poster"}]},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"light"}],"presets":[{"name":"Editorial assortment"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
