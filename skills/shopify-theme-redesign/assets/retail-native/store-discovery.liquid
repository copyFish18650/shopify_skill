{% comment %}Live store data only; this navigation never provisions backend collections.{% endcomment %}
{% assign discovery_count = 0 %}<div class="store-discovery" data-store-discovery>
{% for discovery_collection in collections %}{% if discovery_collection.handle != 'all' and discovery_collection.handle != 'frontpage' and discovery_collection.products_count > 0 and discovery_count < 6 %}{% assign discovery_count = discovery_count | plus:1 %}{% assign discovery_image = discovery_collection.image | default:discovery_collection.products.first.featured_image %}
<a class="store-discovery__item" href="{{ discovery_collection.url }}">{% if discovery_image %}<span class="store-discovery__image">{{ discovery_image | image_url:width:480 | image_tag:widths:'160, 320, 480',sizes:'(min-width:990px) 15vw, 40vw',loading:'lazy',alt:discovery_collection.title }}</span>{% endif %}<span>{{ discovery_collection.title | escape }}{% render 'icon',name:'arrow' %}</span></a>
{% endif %}{% endfor %}
{% if discovery_count == 0 %}{% for discovery_type in collections.all.all_types %}{% if discovery_type != blank and discovery_count < 6 %}{% assign discovery_count = discovery_count | plus:1 %}{% assign discovery_encoded_type = discovery_type | url_encode %}<a class="store-discovery__item store-discovery__item--type" href="{{ routes.collections_url }}/types?q={{ discovery_encoded_type }}"><span>{{ discovery_type | escape }}{% render 'icon',name:'arrow' %}</span></a>{% endif %}{% endfor %}{% endif %}
{% if discovery_count == 0 and collections.all.products_count > 0 %}<a class="store-discovery__item store-discovery__item--type" href="{{ routes.all_products_collection_url }}"><span>{{ 'general.view_all' | t }}{% render 'icon',name:'arrow' %}</span></a>{% endif %}</div>
